.DS_Store

# Generated experiment outputs stay local or on persistent cloud storage.
/results/*
!/results/README.md
!/results/legacy_archive/
!/results/physics_loss_refactor/
/results/legacy_archive/*
!/results/legacy_archive/README.md
/results/physics_loss_refactor/*
!/results/physics_loss_refactor/README.md

# Keep one publication figure tree with filenames that do not use underscores.
/figures/three_dataset_trajectories/
/figures/ThreeDatasetTrajectories/*.tiff

# Local datasets: keep documentation/manifests, never commit raw payloads.
/Oxford Dataset/
datasets/raw/
datasets/processed/
datasets/cache/

# Reproducible cloud-transfer packages are generated locally.
/transfer/
